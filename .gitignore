# FX-ARS .gitignore (FIX-GITIGNORE)

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual envs
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# FX-ARS specific
.fix-backups/
.cleanup-backups/
*.bak
*.orig
*.pre-fix-*

/debug_*.py
/check_*.py
/add_*.py
/fix_*.py
analysis.json
bench.log
*.log
*.tmp

# Data
data/*.db
data/*.db-wal
data/*.db-shm
data/live/
data/history/
data/tmp_tests/
data/*.csv
backup/

# Reports (فقط .gitkeep)
reports/*.md
reports/*.html
!reports/.gitkeep

# Config با اسرار
config/settings.json
config/live.json
!config/settings.example.json
!config/live.example.json

# Secrets
.env
.env.local
*.pem
*.key
*.local.ps1
*.local.json

# Docs (غیرمنبع)
*.docx
*.doc
*.xlsx
*.pdf

# One-off scripts (root)
/get_chat_id.py
/install_*.py
/seed_*.py
/test_mt5.py
/test_analysis_mt5.py

!**/.gitkeep
# FIX: فایل‌های حساس/زائد
data/telegram.json
data/backups/
config/phase.json
config/live.json
config/* - Copy.json
*.bak_*
reports/*.json
reports/*.txt
