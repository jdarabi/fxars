# FX-ARS line ending policy
# Python/TOML/MD/YAML/JSON/SQL/HTML/JS: LF (cross-platform consistency)
# PowerShell/Batch: CRLF (Windows scripts)
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
